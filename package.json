{
  "name": "sandwich-factory",
  "version": "0.1.0",
  "private": true,
  "description": "Sandwich Factory pickup ordering app — Expo app + Cloudflare Worker backend, Square-integrated.",
  "workspaces": [
    "contract",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "backend:dev": "npm --workspace services/backend run dev",
    "mobile:start": "npm --workspace apps/mobile run start",
    "connect-square": "npm --workspace services/backend run connect-square",
    "mirror-catalog": "npm --workspace services/backend run mirror-catalog",
    "add-drink-set": "npm --workspace services/backend run add-drink-set",
    "test:backend": "npm --workspace services/backend run test",
    "test:mobile": "npm --workspace apps/mobile run test",
    "test": "npm run test:backend && npm run test:mobile",
    "test:all": "npm run test:backend && npm run test:mobile"
  }
}
