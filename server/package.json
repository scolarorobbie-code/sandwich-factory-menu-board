{
  "name": "@wisteria/server",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "migrate": "node-pg-migrate --migrations-dir migrations --migration-file-language ts",
    "migrate:up": "npm run migrate -- up",
    "migrate:down": "npm run migrate -- down"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "bcrypt": "^5.1.1",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.16.0",
    "@types/pg": "^8.11.0",
    "eslint": "^9.12.0",
    "node-pg-migrate": "^7.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
