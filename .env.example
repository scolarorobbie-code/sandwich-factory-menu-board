# ============================================================
# wisteria — every environment variable used anywhere in the app
# Copy to .env for local dev. NEVER commit a real value.
# ============================================================

# ---- server/ (Fly.io: set via `fly secrets set`) ----
# Postgres connection string (Fly Postgres in prod, local pg in dev)
DATABASE_URL=postgres://wisteria:wisteria@localhost:5432/wisteria
# Signing secret for JWTs in httpOnly cookies (generate: openssl rand -hex 32)
JWT_SECRET=
# HTTP port the Hono server listens on
PORT=3000
# Base URL of the Cloudflare Worker proxy (the only holder of provider keys)
WORKER_PROXY_URL=https://wisteria-proxy.example.workers.dev
# Shared secret the app server presents to the Worker (openssl rand -hex 32)
WORKER_SHARED_SECRET=
# Allowed CORS origin (the Netlify frontend URL)
CORS_ORIGIN=http://localhost:5173

# ---- worker/ (Cloudflare: set via `wrangler secret put`) ----
# Model provider API key — lives ONLY in the Worker, never here, never in Fly
# LLM_PROVIDER_API_KEY=   (wrangler secret only; listed for completeness)
# WORKER_SHARED_SECRET=   (same value as above; wrangler secret only)

# ---- web/ (Netlify build env; VITE_ vars are PUBLIC — no secrets ever) ----
# App server base URL
VITE_API_URL=http://localhost:3000
